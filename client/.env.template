# Locally, we run in the development environment/
BUILD_TYPE=development

# This sets the Root URI that the UI code tries talk to when it needs to talk
# to the underlying game API. The value of the variable is inlined in the UI
# code when the UI is built.
#
# Leave this empty; the API and the UI are served from the same worker and the
# cookie based authentication requires that calls stay same origin, so all API
# calls and file links are built relative to wherever the UI was loaded from.
GAME_API_ROOT_URI=

# The repository that contains the deployed version of the code. This is used
# to generate github links to commits that are used as a part of a release.
GITHUB_ROOT_URI=https://github.com/OdatNurd/luddatumbazo