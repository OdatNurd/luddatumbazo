{
  "name": "luddatumbazo",
  "main": "./output/service.js",
  "compatibility_date": "2023-12-01",

  "assets": {
    "binding": "STATICS",
    "directory": "./output/client",

    // The worker is the gatekeeper for the application now; these are the
    // paths that need to be checked before the asset layer gets a chance to
    // serve anything (the app shell would otherwise be public), along with the
    // API and file routes, which carry their own guards.
    "run_worker_first": [
      "/",
      "/login",
      "/login/callback",
      "/logout",
      "/api/*",
      "/files/*"
    ]
  },

  // Dev versions should have no route; production versions go directly to our
  // customized route instead.
  //
  // Here the zone_id comes from the API section of the overview page of a site
  // in the CF Dashboard.
  "workers_dev": false,
  "routes": [
    {
      "pattern": "luddatumbazo.odatnurd.net",
      "custom_domain": true,
    },
    {
      "pattern": "luddatumbazo.odatnurd.net/*",
      "zone_id": "228f86abc5bc8b04719dc4671eb09dc0"
    }
  ],

  // For CF Images setup, set up an account and make a note of your account
  // hash, which is readily visible in the images dashboard. Then, set up a page
  // rewrite rule to get at the images for the assigned domain more directly:
  //
  //  1. Log into the CF dash and navigate to the website you want to serve from
  //  2. Select Rules > Transform Rules and pick Create Rule; give it a name
  //  3. Choose 'Custom Expression', click the Edit Expression Link
  //     - Expression: (http.request.uri.path matches "^/images/.*$")
  //  4. Choose 'Then > Rewrite To > Dynamic' and edit the expression
  //     - concat( "/cdn-cgi/imagedelivery/Dx4jrYPNAcY0IcNpYD9HJA", substring(http.request.uri.path, 7) )
  //     also, make sure you add an extra rule so that this only hits the one
  //     site, dummy.
  //
  // In #4, the dx4jr bit is your account hash; that is available in CF Images
  //
  // Images are now available under:
  //   https://luddatumbazo.odatnurd.net/images/<IMAGEID>/<VARIANT-NAME>
  //   https://luddatumbazo.odatnurd.net/cdn-cgi/imagedelivery/Dx4jrYPNAcY0IcNpYD9HJA/<IMAGEID>/<VARIANT-NAME>
  //   https://imagedelivery.net/Dx4jrYPNAcY0IcNpYD9HJA/<IMAGEID>/<VARIANT-NAME>
  //
  // The first two of these are gated behind any IAM on the main application
  // domain, but the third is always public unless the image is not public (in
  // which case the request will require a key to be provided; the app currently
  // makes all images public however).

  //----------------------------------------------------------------------------
  // B I N D I N G S
  //----------------------------------------------------------------------------

  // Bind our data buckets; the name is specified by you when you create the
  // bucket initially.
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "luddatumbazo-assets"
    }
  ],

  // Bind our database; the name and ID come from the D1 page and are visible
  // when you create DB or go back to look at one.
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "8b684b74-2299-4276-a0b2-f6f6d3a65526",
      "database_name": "luddatumbazo"
    }
  ],

  //----------------------------------------------------------------------------
  // G E N E R A L
  //----------------------------------------------------------------------------

  "vars": {
    // The Account ID of the CF account that is running the worker; this is
    // visible from the same place as the zone_id for the worker router; it's
    // specific to an account and not a domain.
    //
    // This is used in all requests to the Cloudflare API, which requires as a
    // path parameter the account ID of the account the API is being invoked
    // for.
    "CF_ACCOUNT_ID": "d8cc4339c920f6d32079a5b483603063",

    // This is actually for the UI and not for the worker, but this is here as a
    // reminder that it should be set for the UI build.
    //
    // It specifies the full URI to the API that this worker runs at and it used
    // at build time to tell the UI code where it should talk to.
    //
    // See .client.dev.vars.template for a template you can copy to
    // .client.dev.vars at the repository root to set this up.
    //"GAME_API_ROOT_URI": "http://localhost:8000",

    // The repository that holds the deployed version of the code; used at UI
    // build time to generate the github links to commits that appear as part
    // of a release. Also a UI build value only; see .client.dev.vars.template.
    //"GITHUB_ROOT_URI": "https://github.com/OdatNurd/luddatumbazo",

  //----------------------------------------------------------------------------
  // S T A T I C   G A M E   A S S E T S
  //----------------------------------------------------------------------------

    // When serving static game assets out of the configured R2 bucket, this
    // sets what the s-maxage value is set to in the returned Cache-Control
    // header, which controls how long the response is cached at the CDN edge
    "ASSET_S_MAXAGE": "3600",

  //----------------------------------------------------------------------------
  // A U T H E N T I C A T I O N
  //----------------------------------------------------------------------------

    // Authentication is done against an OpenID Connect provider (currently
    // Authelia running in the home lab; any OIDC provider, such as Kinde, can
    // be swapped in purely by changing this section).
    //
    // These are the endpoints of that provider. The full URLs are given here
    // rather than a base URI because different providers name their endpoints
    // differently.
    "OIDC_AUTH_URL": "https://auth.thedragonland.net/api/oidc/authorization",
    "OIDC_TOKEN_URL": "https://auth.thedragonland.net/api/oidc/token",
    "OIDC_USERINFO_URL": "https://auth.thedragonland.net/api/oidc/userinfo",

    // The client identifier that this application is registered as at the
    // provider. The redirect URI is no longer configured here; it is derived
    // from the origin of the incoming request (the callback path under the
    // host the browser actually used), so the same deployment works on every
    // hostname it is reached by. Each of those origins must be registered with
    // the provider as an exact redirect URI, which is also what makes a forged
    // Host header harmless: the provider rejects unregistered URIs.
    "OIDC_CLIENT_ID": "luddatumbazo",

    // An optional client secret for a confidential client registration. This
    // must never hold a real value here; provide it as a secret instead (via
    // `wrangler secret put OIDC_CLIENT_SECRET` when deployed, or in .dev.vars
    // for local development).
    //
    // When the secret is present the token exchange authenticates with HTTP
    // Basic; when it is absent the client behaves as a public client exactly as
    // it always has.
    // "OIDC_CLIENT_SECRET": "",

    // The scopes requested when logging in.
    "OIDC_SCOPES": "openid profile email groups",

    // The URL template used to derive the profile picture of a user from their
    // username, for providers that do not hand us a picture directly.
    "PROFILE_URL_TEMPLATE": "https://profiles.thedragonland.net/{username}",

    // How long a minted application session is good for, in seconds; the
    // default is 8 hours, which comfortably covers a full gaming session.
    //
    // Sessions are renewed while they are actively being used (a sliding
    // expiry), so this is effectively how long a session may sit idle before
    // it lapses.
    "SESSION_TTL": "28800",

    // The production version of the API supports being accessed remotely via
    // test or command line tools via a configured service token.
    //
    // A caller that presents the token as an Authorization bearer token acts as
    // the configured user, which must be a user that the system already knows.
    //
    // The token itself should *NEVER* be set here; set it via the dashboard and
    // encrypt it. This is just here as a reminder that the variable needs to
    // exist, including in the .dev.vars file (if you want local tooling to
    // work).
    // "SERVICE_TOKEN": "putsecrettokenhere",

    // The external identifier of the user that the service token acts as.
    "SERVICE_USER": "e2398ed5-0f6e-4273-833d-feb58193b54a",

    // Application sessions are JWTs that we mint and sign ourselves; this is
    // the symmetric key used to sign them.
    //
    // The value should *NEVER* be set here; set it via the dashboard and
    // encrypt it. This is just here as a reminder that the variable needs to
    // exist, including in the .dev.vars file.
    // "SESSION_SECRET": "putsecrettokenhere",

    // The two values below are only used to mint and validate the development
    // token, which is an unsigned JWT accepted only when development mode is
    // on. They are just claim values; the tools/makeJwt.js script embeds them
    // into locally minted tokens and the worker validates them on the way in.
    "CF_TEAM_DOMAIN": "https://odatnurd.cloudflareaccess.com",
    "CF_AUD_TAG": "b8cb09d687d967fbd2d5541b0fa8502dffe66532eb8a4d964834a04e389347fc",

    // If this value is set (which should **NEVER** happen in a real
    // deployment), development tokens are decoded but not validated. This
    // allows local code to work with a structurally intact token without
    // requiring it to be signed. The value of the variable is inconsequential;
    // just being set to anything is an indication of development mode.
    //
    // This should only ever be set in the .dev.vars file.
    // "CF_DEV_MODE": "true",

  //----------------------------------------------------------------------------
  // I M A G E S
  //----------------------------------------------------------------------------

    // When generating URLs for Cloudflare images, this is the template that is
    // used to inject the internal image path and the name of the variant in
    // order to arrive at the final image URL delivered to the browser.
    //
    // See the Images section above; this can be set to the secured domain or to
    // the public one. In this URL, the imagePath is the imageId of the image.
    //
    // You may want to override this value in the .dev.vars file to point to the
    // public version of the URL so that the development version's UI can
    // display images without you having to log into the deployed production
    // application first.
    "CF_IMAGEURL_TEMPLATE": "https://luddatumbazo.odatnurd.net/images/{imagePath}/{variant}",

    // Cloudflare images provides you the ability to have one or more variants,
    // but they are not namespaced to a particular project.
    //
    // This values are used to make our internal names for the image sizes we
    // want (whose names are visible in the CF_VARIANT names) to the actual
    // variant name.
    //
    // For example, a request for a 'boxart' image consults CF_VARIANT_BOXART
    // and determines that the variant name to use is 'cover'.
    "CF_VARIANT_THUMB": "thumb",
    "CF_VARIANT_BOXART": "cover",
    "CF_VARIANT_SMALLBOXART": "entry",

  //----------------------------------------------------------------------------
  // T O K E N S
  //----------------------------------------------------------------------------

    // In order to access the Cloudflare Images API, a token is needed with
    // claims:
    //    "Cloudflare Images: Read"
    //    "Cloudflare Images: Edit"
    //    "Account Analytics: Read"
    //
    // This is used in requests to upload images as well as to gather data about
    // images being served and such.
    //
    // This value should *NEVER* be set here; set it via the dashboard and
    // encrypt it. This is just here as a reminder that the variable needs to
    // exist, including in the .dev.vars file (if you want local code to work).
    // "CF_IMAGES_TOKEN": "secrettokenhere",

    // In order to look games up on BoardGameGeek, a token is needed; since
    // mid-2025 the BGG API requires every request to be authorized with an
    // application token (register at boardgamegeek.com/applications, then
    // create a token for the approved application).
    //
    // The token is sent as a bearer token; without it every BGG lookup will
    // fail with a 401.
    //
    // This value should *NEVER* be set here; set it via the dashboard and
    // encrypt it. This is just here as a reminder that the variable needs to
    // exist, including in the .dev.vars file (if you want local code to work).
    // "BGG_API_TOKEN": "putsecrettokenhere",
  },

  //----------------------------------------------------------------------------
  // D E V   S E R V E R   S E T T I N G S
  //----------------------------------------------------------------------------

  // The dev server binds to all interfaces so that the local nginx proxy can
  // reach it and the application can be exercised through the real domain.
  "dev": {
    "ip": "0.0.0.0",
    "port": 3000
  },

  //----------------------------------------------------------------------------
  // P R E B U I L D
  //----------------------------------------------------------------------------

  "build": {
    "command": "rollup -c rollup.service.js",
    "watch_dir": ["./service/src"]
  },
}