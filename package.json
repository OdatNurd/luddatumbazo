{
  "name": "luddatumbazo",
  "version": "0.0.1",
  "private": true,
  "description": "A home grown tool for tracking board game ownership and plays",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "repository": "https://github.com/OdatNurd/luddatumbazo",
  "author": {
    "name": "OdatNurd",
    "email": "odatnurd@gmail.com",
    "url": "https://odatnurd.net"
  },
  "scripts": {
    "check": "svelte-check",
    "client:build": "rollup -c rollup.client.js",
    "client:watch": "rollup -c rollup.client.js -w",
    "db:dump": "node ./tools/dumpLocalDB.js",
    "jwt:create": "node ./tools/makeJwt.js",
    "lint": "eslint \"client/src/**/*.svelte\"",
    "local:seed-db": "cd service && npm run local:seed-db",
    "service:deploy": "wrangler deploy",
    "service:run": "wrangler dev --persist-to ~/.config/.wrangler/state/",
    "test": "aegis test/aegis.config.js"
  },
  "imports": {
    "#db/*": "./service/src/db/*.js",
    "#sql/*": "./service/src/sql/*.sql",
    "#routes/*": "./service/src/routes/*.js",
    "#schema/*": "./service/src/schema/*.js",
    "#lib/*": "./service/src/lib/*.js",
    "#legacyvalidator": "./service/src/lib/validateZod.js"
  },
  "dependencies": {
    "@awesome.me/webawesome-pro": "^3.14.0",
    "@axel669/sanic-xml": "^0.3.0",
    "@odatnurd/cf-requests": "^0.1.16",
    "@odatnurd/d1-query": "^0.3.2",
    "dotenv": "^18.0.8",
    "entities": "^8.1.0",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "luxon": "^3.7.2",
    "slug": "^12.0.1",
    "svelte": "^5.57.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axel669/aegis": "0.3.1",
    "@axel669/asuid": "^0.2.1",
    "@axel669/hono-file-routes": "^1.0.2",
    "@axel669/rollup-copy-static": "^0.2.0",
    "@axel669/rollup-dollar-path": "^0.1.0",
    "@axel669/rollup-html-input": "^0.1.2",
    "@odatnurd/cf-aegis": "^0.1.10",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/luxon": "^3.7.6",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fs-jetpack": "^5.1.0",
    "json5": "^2.2.3",
    "miniflare": "^4.20260730.0",
    "rollup": "^4.65.0",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-svelte": "^7.2.3",
    "svelte-check": "^4.7.7",
    "wrangler": "^4.151.3"
  }
}
