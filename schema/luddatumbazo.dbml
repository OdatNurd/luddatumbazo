// Luddatumbazo was my 2023 Devember project; a mini version of BoardGameGeek
// to allow me and my wife to easily track our boardgame collection and plays.
//
// The code can be found at:
//    https://github.com/OdatNurd/devember-2023
//
// This particular file is a DBML file that is viewable via:
//    https://dbdiagram.io/
Project Luddatumbazo {
  database_type: 'SQLite'
  Note: 'Personalized Board Game ownership and playtime tracker'
}


// -----------------------------------------------------------------------------
// These tables track Users and Guests.
//
// In the parlance of the system, a User is someone that has been granted the
// authorization to log into the application and directly view it; this is done
// via an OpenID Connect provider (Authelia, currently), which does all of the
// authentication and provides us with a unique identifier to track the user
// (externalId).
//
// Guests are people that played games that are reported but which do not have
// access to the application, or people that used to have access and no longer
// do.
// -----------------------------------------------------------------------------

Table User {
  id INTEGER [pk, unique, increment]

  externalId TEXT [unique, not null, note: 'unique identifier based on the external auth being used']
  username TEXT [note: 'the login handle of the user at the external auth provider']

  firstName TEXT [not null, note: 'collate nocase']
  lastName TEXT [not null, note: 'collate nocase']
  displayName TEXT [not null, note: 'collate nocase']

  // SQLite generates this automatically whenever a record is added or
  // updated.
  name GENERATED [note: 'GENERATED ALWAYS AS (firstName || space || lastName) STORED']

  emailAddress TEXT [not null]
  picture TEXT [note: 'URL of the profile picture of this user']

  indexes {
    externalId [name: 'idx_user_ext']
  }

  Note: 'A known user in the system; associates an external authentication ID with a specific user'
}

// -----------------------------------------------------------------------------

Table GuestUser {
  id INTEGER [pk, unique, increment]

  firstName TEXT [not null, note: 'collate nocase']
  lastName TEXT [not null, note: 'collate nocase']
  displayName TEXT [not null, note: 'collate nocase']

  // SQLite generates this automatically whenever a record is added or
  // updated.
  name GENERATED [note: 'GENERATED ALWAYS AS (firstName || space || lastName) STORED']

  indexes {
    (firstName, lastName) [name: 'idx_guest_name', unique]
  }

  Note: 'A guest user of the system; for participating in session reports'
}


// -----------------------------------------------------------------------------
// Tables in this section track games that exist in the system and the data that
// is associated with them.
//
// Some types of data are also available on BoardGameGeek pages directly for
// viewing, and so in various places there is a bggId style field that allows
// for creating links. These fields are optional, and where 0 they indicate that
// there is no BGG specific data for that item.
//
// Games are known by many names, so we associate a list of names per game via
// a table, with one name being the "primary" name used to refer to the game.
//
// Games may have expansions, and expansions themselves may also be the base of
// some other expansion (e.g. if one expansion is required to be used with a
// second expansion), so our table holds those associations as well.
// -----------------------------------------------------------------------------

Table Game {
  id INTEGER [pk, unique, increment]
  bggId INTEGER [not null, default: 0]

  slug TEXT [unique, not null, note: 'the slug is based on the primary name of the game at the time it was added']
  description TEXT [not null]
  publishedIn INTEGER [not null]

  minPlayers INTEGER [default: 1]
  maxPlayers INTEGER [default: 1]
  minPlayerAge INTEGER [default: 1]

  playtime INTEGER [default: 1]
  minPlaytime INTEGER [default: 1]
  maxPlaytime INTEGER [default: 1]
  complexity REAL [default: 1.0]

  officialURL TEXT [default: '']
  teachingURL TEXT [default: '', note: 'Link to a YT video that teaches this game']

  imagePath TEXT [default: '', note: 'a URI like cfi://imagename']

  indexes {
    slug [name: 'idx_game_slug']
  }

  Note: 'A representation of a unique game'
}

// -----------------------------------------------------------------------------

Table GameName {
  id INTEGER [pk, unique, increment]
  gameId INTEGER [not null, ref: > Game.id]

  name TEXT [not null, note: 'collate nocase']
  isPrimary INTEGER [default: false, note: 'The primary is the name this is best known by']

  indexes {
    gameId [name: 'idx_gamename_id']
    (gameId, isPrimary) [name: 'idx_gamename_primary']
    name [name: 'idx_gamename_name']
  }

  Note: 'Associates alternate game names with game IDs. idx_gamename_primary is a partial unique index (WHERE isPrimary = 1)'
}

// -----------------------------------------------------------------------------

// In this table, it is possible for either the base OR the expansion id to be
// a NULL value, to indicate that part of the relation does not currently exist
// in our database yet (e.g. we own a game but not the expansions).
//
// In order for this to occur, the bggId associated with that side must not be 0
// because it is required to know what the other side of the relation is
// supposed to be.
//
// In the specific case of one of the two ID's being NULL, the entryName field
// is the name of the item that is null (i.e. "missing"), so that it can be
// displayed in links.
//
// Once the association is completed, this field is ignored; when it is present
// it provides a human readable hint as to which part of the association was
// originally missing.
Table GameExpansion {
  id INTEGER [pk, unique, increment]

  baseGameId INTEGER [ref: > Game.id, note: 'is null when this game is not in the DB yet']
  baseGameBggId INTEGER [default: 0]
  expansionGameId INTEGER [ref: > Game.id, note: 'is null when this game is not in the DB yet']
  expansionGameBggId INTEGER [default: 0]

  entryName TEXT [note: 'this is only used when one side of the relation is not a game, to reflect the name of that item']

  indexes {
    baseGameId [name: 'idx_game_expand_base']
    expansionGameId [name: 'idx_game_expand_expansion']
    baseGameBggId [name: 'idx_game_expand_base_bgg']
    expansionGameBggId [name: 'idx_game_expand_expansion_bgg']
  }

  Note: 'Associates a game with an expansion for that game; one side always has a gameId, the other could be null. The bgg indexes are partial (WHERE bggId > 0)'
}


// -----------------------------------------------------------------------------
// Tables in this section store the metadata that is associated with games in
// our database. This falls into one of a series of "metaTypes", where we have
// a list of items for each type, and a table that associates that metadata with
// specific games.
// -----------------------------------------------------------------------------

// The distinct types of metadata that are supported by the system; using a
// value that is not here throws a constraint error.
enum metadata_type {
  designer
  artist
  publisher
  mechanic
  category
}

// -----------------------------------------------------------------------------

Table GameMetadata {
  id INTEGER [pk, unique, increment]

  metatype metadata_type
  bggId INTEGER [default: 0]
  slug TEXT [not null]
  name TEXT [not null]

  indexes {
    (metatype, bggId) [name: 'idx_metadata_type_map']
    (metatype, slug) [name: 'idx_metadata_metaslug_map', unique]
    slug [name: 'idx_metadata_slug_map']
  }

  Note: 'Typed metadata record; each record associates with a potential BGG entry'
}

// -----------------------------------------------------------------------------

// There is one row in this table for every association of a metadata item with
// a game.
Table GameMetadataPlacement {
  id INTEGER [pk, unique, increment]

  gameId INTEGER [not null, ref: > Game.id]

  metatype metadata_type [not null]
  itemId INTEGER [ref: > GameMetadata.id]

  indexes {
    (gameId, metatype, itemId) [name: 'idx_metadata_place_map']
  }

  Note: 'Associates known metadata records with a specific game'
}


// -----------------------------------------------------------------------------
// Tables in this section are related to the ownership of games and the
// relationships between different users.
//
// We take the tack of saying that games are owned or wished for not by a user
// but by a "household" instead, so that multiple users from the same house do
// not need to maintain their collection of games distinctly. The presumption
// is that people living in the same house can play the same games.
//
// Thus, we create one or more households, assign users to one or more household
// groups, and then associate game ownership, loans and wishlists to a household
// instead.
// -----------------------------------------------------------------------------

Table Household {
  id INTEGER [pk, unique, increment]

  name TEXT [not null, unique]
  slug TEXT [not null, unique]

  indexes {
    slug [name: 'idx_household_slug']
  }

  Note: 'Users can exist in one or more households; a household tracks who owns games'
}

// -----------------------------------------------------------------------------

Table UserHousehold {
  id INTEGER [pk, unique, increment]

  userId INTEGER [not null, ref: > User.id]
  householdId INTEGER [not null, ref: > Household.id]
  isPrimary INTEGER [default: false, note: 'The primary household for this user']

  indexes {
    (userId, householdId) [name: 'idx_user_household_combo', unique]
    householdId [name: 'idx_user_household']
    userId [name: 'idx_user_household_primary']
  }

  Note: 'Register that a specific user resides in a specific household. idx_user_household_primary is a partial unique index (WHERE isPrimary = 1)'
}

// -----------------------------------------------------------------------------

Table StorageLocation {
  id INTEGER [pk, unique, increment]

  householdId INTEGER [not null, ref: > Household.id, delete: cascade]
  parentId INTEGER [ref: > StorageLocation.id, delete: restrict]
  name TEXT [not null, note: 'case-insensitive; unique among siblings']
  slug TEXT [not null, note: 'stable slug created when the location is created']

  indexes {
    (householdId, parentId, name) [name: 'idx_storage_location_sibling_name', unique]
    (householdId, slug) [name: 'idx_storage_location_slug', unique]
    householdId [name: 'idx_storage_location_household']
    parentId [name: 'idx_storage_location_parent']
  }

  Note: 'Household-owned storage tree; null parent is a top-level location. The sibling index uses COALESCE(parentId, 0) so root siblings are unique too. Triggers keep parent and child in the same household'
}

// -----------------------------------------------------------------------------

Table GameOwners {
  id INTEGER [pk, unique, increment]

  householdId INTEGER [not null, ref: > Household.id]
  gameId INTEGER [not null, ref: > Game.id]

  gameName INTEGER [not null, ref: > GameName.id]
  gamePublisher INTEGER [not null, ref: > GameMetadata.id]

  storageLocationId INTEGER [ref: > StorageLocation.id, delete: restrict, note: 'NULL means Unstored']
  isOnShelf INTEGER [not null, default: 0, note: 'Only valid when storageLocationId is set']

  indexes {
    gameId [name: 'idx_game_owner_games']
    (householdId, gameId, gameName) [name: 'idx_game_owner_list']
    (householdId, storageLocationId, isOnShelf) [name: 'idx_game_owner_storage']
  }

  Note: 'Game ownership is tracked by household; storage is per owned copy. Triggers keep the storage location in the same household and reject on-shelf rows without a location'
}

// -----------------------------------------------------------------------------

Table GameLoans {
  id INTEGER [pk, unique, increment]

  gameId INTEGER [not null, ref: > GameOwners.id]

  loanedTo INTEGER [not null, ref: > Household.id]
  loanTime DATE [not null]

  Note: 'A game copy currently (or formerly) loaned to another household'
}

// -----------------------------------------------------------------------------

Table WishList {
  id INTEGER [pk, unique, increment]

  householdId INTEGER [not null, ref: > Household.id]
  name TEXT [not null]
  slug TEXT [not null]

  isRoot INTEGER [default: false]

  indexes {
    (householdId, slug) [name: 'idx_wishlist', unique]
    householdId [name: 'idx_wishlist_roots']
  }

  Note: 'A named wishlist owned by a household; isRoot marks its default list. idx_wishlist_roots is a partial unique index (WHERE isRoot = 1)'
}

// -----------------------------------------------------------------------------

Table WishlistContents {
  id INTEGER [pk, unique, increment]

  householdId INTEGER [not null, ref: > Household.id]
  wishlistId INTEGER [not null, ref: > WishList.id]

  gameId INTEGER [not null, ref: > Game.id]
  gameName INTEGER [not null, ref: > GameName.id]

  addedByUserId INTEGER [not null, ref: > User.id]

  indexes {
    (householdId, gameId, gameName, wishlistId) [name: 'idx_wishlist_content']
  }

  Note: 'Games wished for inside a specific household wishlist'
}


// -----------------------------------------------------------------------------
// Tables in this session relate to session reporting in the system.
//
// Session reports track the game that was played, any expansions that were used
// as a part of the play, a title and some descriptive text, the time the
// session started and stopped, and a set of players and their scores.
//
// For the purposes of session reporting, it is possible for people that are
// not users of the system to participate, so Guests are allowed to participate
// in sessions.
//
// Every report can be marked as "learning", which is just metadata to indicate
// that this play of the game at least one player was learning how to play, so
// that such sessions can excluded from statistics and the like.
//
// The system does not enforce that there is any specific start player or winner
// or that scores are set, since different games work different ways.
// -----------------------------------------------------------------------------

// The distinct types of sessions that are supported by the system; using a
// value that is not here throws a constraint error.
enum session_play_type {
  cardboard
  boardgamearena
  steam
  gog
  android
}

// -----------------------------------------------------------------------------

Table SessionReport {
  id INTEGER [pk, unique, increment]

  gameId INTEGER [not null, ref: > Game.id]
  gameName INTEGER [not null, ref: > GameName.id]
  playType session_play_type

  // The authenticated user who filed the report. This is nullable only for
  // legacy rows from before the session reporting migration; new reports
  // always set it. It is the source of truth for who may edit a closed report.
  loggingPlayerId INTEGER [ref: > User.id]

  sessionBegin TIME [not null]
  sessionEnd TIME [default: null]

  isLearning INTEGER [default: false]

  indexes {
    gameId [name: 'idx_session_game']
    (gameId, gameName) [name: 'idx_session_game_names']
    loggingPlayerId [name: 'idx_session_logging_player']
    (gameId, sessionBegin) [name: 'idx_session_game_begin']
    sessionBegin [name: 'idx_session_begin']
  }

  Note: 'An entry for a specific session report. playType is constrained to the five values in session_play_type even though SessionGameType seeds additional types'
}

// -----------------------------------------------------------------------------

Table SessionReportExpansions {
  id INTEGER [pk, unique, increment]

  sessionId INTEGER [not null, ref: > SessionReport.id]
  expansionId INTEGER [not null, ref: > Game.id]
  expansionName INTEGER [not null, ref: > GameName.id]

  indexes {
    (sessionId, expansionId) [name: 'idx_session_expansion_game']
  }

  Note: 'Entries in this table are used to associate game expansions used during a play session'
}

// -----------------------------------------------------------------------------

Table SessionReportPlayer {
  id INTEGER [pk, unique, increment]

  sessionId INTEGER [not null, ref: > SessionReport.id]
  userId INTEGER [ref: > User.id, note: 'is null when the record tracks a guest']
  guestId INTEGER [ref: > GuestUser.id, note: 'is null when the record tracks a user']

  // Display/back-compat flag: true only when this player is also the session's
  // loggingPlayerId. It is not the source of truth for ownership.
  isReporter INTEGER [default: false]
  isStartingPlayer INTEGER [default: false]

  score INTEGER [default: 0]
  isWinner INTEGER [default: false]

  indexes {
    (sessionId, userId) [name: 'idx_session_players']
    (sessionId, guestId) [name: 'idx_session_guests']
    (userId, sessionId) [name: 'idx_session_players_by_user']
    (guestId, sessionId) [name: 'idx_session_guests_by_guest']
  }

  Note: 'Tracks a specific player or user in a specific session report entry. All four indexes are partial: player indexes require the matching id to be non-null'
}

// -----------------------------------------------------------------------------

Table SessionReportDetails {
  id INTEGER [pk, unique, increment]

  sessionId INTEGER [not null, ref: > SessionReport.id]
  title TEXT [default: '']
  content TEXT [default: '']

  indexes {
    sessionId [name: 'idx_session_details']
  }

  Note: 'Contains the textual content of a detailed session report'
}

// -----------------------------------------------------------------------------

Table SessionGameType {
  id INTEGER [pk, unique, increment]

  slug TEXT [unique, not null]
  name TEXT [not null]
  icon TEXT [not null]

  Note: 'Lookup table of game platforms. Seed rows: cardboard, boardgamearena, steam, gog, android, tabletsimulator, drgncards'
}


// -----------------------------------------------------------------------------
// Saved Game Picker filter sets, shared by everyone in a household. The filter
// itself is validated JSON; the schema is the contract, not this column.
// -----------------------------------------------------------------------------

Table GamePickerFilter {
  id INTEGER [pk, unique, increment]

  householdId INTEGER [not null, ref: > Household.id, delete: cascade]
  userId INTEGER [not null, ref: > User.id]

  name TEXT [not null, note: 'collate nocase']
  filterJson TEXT [not null]

  createdAt TIME [not null]
  updatedAt TIME [default: null]

  indexes {
    (householdId, name) [name: 'idx_picker_filter_name', unique]
    (householdId, updatedAt) [name: 'idx_picker_filter_household']
  }

  Note: 'Saved Game Picker filters; household-scoped and named'
}


// -----------------------------------------------------------------------------
// Binary assets (images and similar) stored for games in object storage.
// -----------------------------------------------------------------------------

Table GameAssets {
  id INTEGER [pk, unique, increment]

  gameId INTEGER [not null, ref: > Game.id]

  mimetype TEXT [not null]
  filename TEXT [not null]

  description TEXT [not null]

  createdAt TIME [not null]
  updatedAt TIME [default: null]

  bucketKey TEXT [unique, not null]

  indexes {
    bucketKey [name: 'idx_game_asset_bucketKey']
  }

  Note: 'Stored binary asset metadata; bucketKey identifies the object in the file bucket'
}

// -----------------------------------------------------------------------------
